{
  "manifest_version": 3,
  "name": "Extainium",
  "version": "0.1.3",
  "description": "Install and update browser extensions from GitHub releases (.crx or .zip), like Obtainium does for apps. Built for Titanium on Android.",
  "permissions": [
    "downloads",
    "storage",
    "alarms",
    "management"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extainium"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
