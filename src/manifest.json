{
  "manifest_version": 3,
  "name": "Extainium",
  "version": "0.1.19",
  "description": "Install and update browser extensions from GitHub releases (.crx or .zip), like Obtainium does for apps. Built for Titanium on Android.",
  "permissions": [
    "downloads",
    "storage",
    "alarms",
    "management",
    "webRequest"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://clients2.google.com/*",
    "https://clients2.googleusercontent.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extainium",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
